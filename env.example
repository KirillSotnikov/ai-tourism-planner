# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (default: gpt-6-luna). If quality isn't good enough: gpt-6.1-terra
# Check https://developers.openai.com/docs/deprecations before changing.
OPENAI_MODEL=gpt-6-luna

# Optional: reasoning effort for reasoning models (e.g. low). Fewer hidden reasoning tokens = lower cost.
# OPENAI_REASONING_EFFORT=low

# Optional: only for non-reasoning models (reasoning models reject custom temperature)
# OPENAI_TEMPERATURE=0.7

# Server Configuration
PORT=8080

# CORS Configuration
# Set this to your frontend URL (e.g., http://localhost:3000)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Rate limiting (per client IP)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000

# Set to 1 when running behind one reverse proxy (nginx, load balancer)
# so the rate limiter sees real client IPs.
# TRUST_PROXY=1

# Optional: Logging Level
# LOG_LEVEL=info 
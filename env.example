# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (default: gpt-6-luna). If quality isn't good enough: gpt-6.1-terra
# Check https://developers.openai.com/docs/deprecations before changing.
OPENAI_MODEL=gpt-6-luna

# Optional: reasoning effort for reasoning models (e.g. low). Fewer hidden reasoning tokens = lower cost.
# OPENAI_REASONING_EFFORT=low

# Optional: only for non-reasoning models (reasoning models reject custom temperature)
# OPENAI_TEMPERATURE=0.7

# Server Configuration
PORT=8080

# CORS Configuration
# Set this to your frontend URL (e.g., http://localhost:3000)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Rate limiting (per client IP)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000

# Hard cap on OpenAI calls per day across ALL users (resets 00:00 UTC).
# Holds even if an abuser rotates IPs. Rough cost ceiling with gpt-6-luna: ~$0.001 x this value.
DAILY_REQUEST_LIMIT=300

# Max tokens generated per request (includes hidden reasoning tokens)
MAX_OUTPUT_TOKENS=5000

# Comma-separated IPs to block (find them in the request logs)
# BLOCKED_IPS=203.0.113.5,198.51.100.7

# Set to 1 when running behind one reverse proxy (nginx, load balancer)
# so the rate limiter sees real client IPs.
# Do NOT set it if clients connect to Node directly: they could then fake their IP
# via the X-Forwarded-For header and bypass the per-IP limit.
# TRUST_PROXY=1

# Optional: Logging Level
# LOG_LEVEL=info 